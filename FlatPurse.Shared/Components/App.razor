@using FlatPurse.Components.Layout
@inject FlatPurse.Services.IAuthService AuthService
@inject FlatPurse.Services.ITokenStorage TokenStorage
@inject FlatPurse.Services.IAppStateService AppState
@inject NavigationManager Nav

@if (_ready)
{
    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@(new[] { typeof(App).Assembly })">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(AuthLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(AuthLayout)">
                <p role="alert">Page not found.</p>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        // Try to restore an existing session from stored token.
        var restored = await AuthService.TryRestoreSessionAsync();

        if (!restored)
        {
            // No valid session — decide where to land.
            var seenOnboarding = await TokenStorage.HasSeenOnboardingAsync();
            var currentPath = new Uri(Nav.Uri).AbsolutePath;

            // Only redirect from the root; leave explicit deep-links alone.
            if (currentPath == "/" || currentPath == "/dashboard")
            {
                Nav.NavigateTo(seenOnboarding ? "/login" : "/welcome", replace: true);
            }
        }

        _ready = true;
    }
}
