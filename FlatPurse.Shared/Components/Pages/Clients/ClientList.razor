@page "/clients"
@layout MainLayout
@using FlatPurse.Models
@using FlatPurse.Components.Shared
@inject FlatPurse.Services.IClientService ClientService
@inject FlatPurse.Services.IAppStateService AppState
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <h1 class="page-title">Clients</h1>
        <p class="page-subtitle">@_total clients total</p>
    </div>
    <button class="btn btn-primary" @onclick="() => _showAddModal = true">+ Add Client</button>
</div>

<div class="filters-bar">
    <input class="search-input" type="search" placeholder="Search clients..." @bind="_searchQuery" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />

    <select class="filter-select" @bind="_selectedTag" @bind:after="LoadClientsAsync">
        <option value="">All Tags</option>
        @foreach (var tag in Enum.GetValues<ClientTag>())
        {
            <option value="@tag">@tag</option>
        }
    </select>

    <select class="filter-select" @bind="_selectedRisk" @bind:after="LoadClientsAsync">
        <option value="">All Risk Levels</option>
        @foreach (var risk in Enum.GetValues<ChurnRisk>())
        {
            <option value="@risk">@risk</option>
        }
    </select>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_clients.Count == 0)
{
    <EmptyState Message="No clients found. Try adjusting your filters." />
}
else
{
    <div class="client-grid">
        @foreach (var client in _clients)
        {
            <ClientCard Client="@client" OnClick="@(() => Nav.NavigateTo($"/clients/{client.Id}"))" />
        }
    </div>

    <div class="pagination">
        <button class="btn btn-ghost" disabled="@(_page <= 1)" @onclick="PrevPage">Previous</button>
        <span>Page @_page</span>
        <button class="btn btn-ghost" disabled="@(_clients.Count < _limit)" @onclick="NextPage">Next</button>
    </div>
}

@if (_showAddModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Add New Client</h2>
                <button class="modal-close" @onclick="CloseModal">&#x2715;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_addError))
                {
                    <div class="alert alert-error" style="margin-bottom:16px">@_addError</div>
                }
                <div class="form-group">
                    <label class="form-label">First Name *</label>
                    <input class="form-control" type="text" @bind="_newFirstName" placeholder="First name" />
                </div>
                <div class="form-group">
                    <label class="form-label">Last Name *</label>
                    <input class="form-control" type="text" @bind="_newLastName" placeholder="Last name" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" @bind="_newEmail" placeholder="client@email.com" />
                </div>
                <div class="form-group">
                    <label class="form-label">Phone</label>
                    <input class="form-control" type="tel" @bind="_newPhone" placeholder="+1 (555) 000-0000" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="AddClientAsync" disabled="@_addingClient">
                    @(_addingClient ? "Adding..." : "Add Client")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ClientDto> _clients = new();
    private int _total;
    private int _page = 1;
    private const int _limit = 50;
    private bool _loading = true;
    private string _searchQuery = string.Empty;
    private string _selectedTag = string.Empty;
    private string _selectedRisk = string.Empty;
    private bool _showAddModal;
    private System.Timers.Timer? _debounceTimer;

    // Add Client modal fields
    private string _newFirstName = string.Empty;
    private string _newLastName = string.Empty;
    private string? _newEmail;
    private string? _newPhone;
    private bool _addingClient;
    private string? _addError;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadClientsAsync();
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Stop();
        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer.Stop();
            await InvokeAsync(async () =>
            {
                _page = 1;
                await LoadClientsAsync();
            });
        };
        _debounceTimer.Start();
    }

    private async Task LoadClientsAsync()
    {
        _loading = true;
        StateHasChanged();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var results = await ClientService.SearchClientsAsync(_searchQuery);
            _clients = results?.ToList() ?? new();
            _total = _clients.Count;
        }
        else
        {
            ClientTag? tag = Enum.TryParse<ClientTag>(_selectedTag, out var t) ? t : null;
            ChurnRisk? risk = Enum.TryParse<ChurnRisk>(_selectedRisk, out var r) ? r : null;
            var result = await ClientService.GetClientsAsync(_page, _limit, tag: tag, churnRisk: risk);
            _clients = result?.Items ?? new();
            _total = result?.Total ?? 0;
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task PrevPage()
    {
        if (_page > 1) { _page--; await LoadClientsAsync(); }
    }

    private async Task NextPage()
    {
        _page++;
        await LoadClientsAsync();
    }

    private void CloseModal()
    {
        _showAddModal = false;
        _newFirstName = string.Empty;
        _newLastName = string.Empty;
        _newEmail = null;
        _newPhone = null;
        _addError = null;
    }

    private async Task AddClientAsync()
    {
        _addError = null;

        if (string.IsNullOrWhiteSpace(_newFirstName) || string.IsNullOrWhiteSpace(_newLastName))
        {
            _addError = "First name and last name are required.";
            return;
        }

        _addingClient = true;
        StateHasChanged();

        try
        {
            var req = new CreateClientRequest(
                _newFirstName.Trim(),
                _newLastName.Trim(),
                string.IsNullOrWhiteSpace(_newEmail) ? null : _newEmail.Trim(),
                string.IsNullOrWhiteSpace(_newPhone) ? null : _newPhone.Trim(),
                null);

            var created = await ClientService.CreateClientAsync(req);
            if (created != null)
            {
                CloseModal();
                _page = 1;
                await LoadClientsAsync();
            }
            else
            {
                _addError = "Failed to add client. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _addError = $"Error: {ex.Message}";
        }
        finally
        {
            _addingClient = false;
            StateHasChanged();
        }
    }
}
