@page "/bookings/success"
@layout MainLayout
@inject NavigationManager Nav
@inject FlatPurse.Services.IAppStateService AppState

<div class="success-page">
    <div class="success-card">
        <div class="success-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
        </div>
        <h1 class="success-title">You're all set! 🎉</h1>
        <p class="success-sub">Your booking has been confirmed and the client will receive a reminder automatically.</p>

        <div class="success-details">
            <div class="success-detail-row">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span>Booking confirmation sent to client</span>
            </div>
            <div class="success-detail-row">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                </svg>
                <span>AutoPilot reminder scheduled 24h before</span>
            </div>
            <div class="success-detail-row">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>Deposit secured against no-shows</span>
            </div>
        </div>

        <div class="success-actions">
            <a href="/bookings/new" class="btn btn-primary">Book another</a>
            <a href="/" class="btn btn-secondary">Go to Dashboard</a>
            <a href="/bookings" class="btn btn-ghost">View all bookings</a>
        </div>
    </div>
</div>
