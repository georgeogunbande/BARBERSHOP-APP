@page "/bookings/new"
@using System.Text.Json
@using FlatPurse.Models
@using FlatPurse.Components.Shared
@inject FlatPurse.Services.IBookingService BookingService
@inject FlatPurse.Services.IClientService ClientService
@inject FlatPurse.Services.IAppStateService AppState
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <button class="btn-back" @onclick="@(() => Nav.NavigateTo("/bookings"))">&#8592; Bookings</button>
        <h1 class="page-title">New Booking</h1>
    </div>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <div class="booking-form">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-error">@_errorMessage</div>
        }

        <div class="form-section">
            <h3>Client</h3>
            <div class="form-group">
                <input class="form-control" type="search" placeholder="Search client..." @bind="_clientSearch" @bind:event="oninput" @onkeyup="OnClientSearch" />
                @if (_clientResults.Any())
                {
                    <ul class="search-dropdown">
                        @foreach (var c in _clientResults)
                        {
                            <li @onclick="() => SelectClient(c)">@c.FirstName @c.LastName — @c.Phone</li>
                        }
                    </ul>
                }
                @if (_selectedClient != null)
                {
                    <div class="selected-badge">
                        Selected: <strong>@_selectedClient.FirstName @_selectedClient.LastName</strong>
                        <button @onclick="() => _selectedClient = null">&#x2715;</button>
                    </div>
                }
            </div>
        </div>

        <div class="form-section">
            <h3>Service</h3>
            <div class="form-group">
                <InputSelect class="form-control" @bind-Value="_selectedServiceId">
                    <option value="">Choose service...</option>
                    @foreach (var svc in _services)
                    {
                        <option value="@svc.Id">@svc.Name — $@svc.Price (@svc.DurationMins min)</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-section">
            <h3>Staff</h3>
            <div class="form-group">
                <InputSelect class="form-control" @bind-Value="_selectedStaffId">
                    <option value="">Choose staff...</option>
                    @foreach (var s in _staff)
                    {
                        <option value="@s.Id">@s.FirstName @s.LastName</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-section">
            <h3>Date & Time</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>Date</label>
                    <input type="date" class="form-control" @bind="_bookingDate" @bind:after="LoadSlotsAsync" />
                </div>
            </div>
            @if (_availableSlots.Any())
            {
                <div class="slots-grid">
                    @foreach (var slot in _availableSlots)
                    {
                        <button class="slot-btn @(_selectedStartsAt == slot.StartsAt ? "selected" : "")"
                                @onclick="() => SelectSlot(slot)">
                            @slot.StartsAt.ToString("h:mm tt")
                        </button>
                    }
                </div>
            }
        </div>

        <div class="form-group">
            <label>Notes (optional)</label>
            <textarea class="form-control" rows="3" @bind="_notes" placeholder="Any special requests..."></textarea>
        </div>

        <button class="btn btn-primary btn-full" @onclick="CreateBookingAsync" disabled="@_submitting">
            @(_submitting ? "Creating..." : "Create Booking")
        </button>
    </div>
}

@code {
    private bool _loading = true;
    private bool _submitting;
    private string? _errorMessage;

    private List<ServiceDto> _services = new();
    private List<StaffDto> _staff = new();
    private List<TimeSlotDto> _availableSlots = new();
    private List<ClientDto> _clientResults = new();

    private ClientDto? _selectedClient;
    private string _clientSearch = string.Empty;
    private string _selectedServiceId = string.Empty;
    private string _selectedStaffId = string.Empty;
    private DateTime _bookingDate = DateTime.Today;
    private DateTime? _selectedStartsAt;
    private string _notes = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var services = await BookingService.GetServicesAsync();
        _services = services?.ToList() ?? new();

        var staff = await BookingService.GetStaffAsync();
        _staff = staff?.ToList() ?? new();

        _loading = false;
        StateHasChanged();
    }

    private async Task OnClientSearch(KeyboardEventArgs e)
    {
        if (_clientSearch.Length < 2) { _clientResults.Clear(); return; }
        var results = await ClientService.SearchClientsAsync(_clientSearch);
        _clientResults = results?.Take(5).ToList() ?? new();
        StateHasChanged();
    }

    private void SelectClient(ClientDto client)
    {
        _selectedClient = client;
        _clientSearch = string.Empty;
        _clientResults.Clear();
        StateHasChanged();
    }

    private void SelectSlot(TimeSlotDto slot)
    {
        _selectedStartsAt = slot.StartsAt;
        StateHasChanged();
    }

    private async Task LoadSlotsAsync()
    {
        if (!Guid.TryParse(_selectedServiceId, out var serviceId)) return;
        Guid? staffId = Guid.TryParse(_selectedStaffId, out var sid) ? sid : null;

        var slots = await BookingService.GetAvailableSlotsAsync(serviceId, staffId, _bookingDate);
        if (slots != null)
        {
            var json = JsonSerializer.Serialize(slots);
            _availableSlots = JsonSerializer.Deserialize<List<TimeSlotDto>>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        StateHasChanged();
    }

    private async Task CreateBookingAsync()
    {
        if (_selectedClient == null) { _errorMessage = "Please select a client."; return; }
        if (!Guid.TryParse(_selectedServiceId, out var serviceId)) { _errorMessage = "Please select a service."; return; }
        if (!Guid.TryParse(_selectedStaffId, out var staffId)) { _errorMessage = "Please select a staff member."; return; }
        if (_selectedStartsAt == null) { _errorMessage = "Please select a time slot."; return; }

        _submitting = true;
        _errorMessage = null;
        StateHasChanged();

        var req = new CreateBookingRequest(_selectedClient.Id, serviceId, staffId, _selectedStartsAt.Value, _notes);
        var booking = await BookingService.CreateBookingAsync(req);

        if (booking != null)
            Nav.NavigateTo("/bookings/success");
        else
        {
            _errorMessage = "Failed to create booking. The slot may no longer be available.";
            _submitting = false;
            StateHasChanged();
        }
    }
}
