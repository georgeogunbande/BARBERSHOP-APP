@page "/login"
@layout FlatPurse.Components.Layout.AuthLayout
@inject FlatPurse.Services.AuthService AuthService
@inject FlatPurse.Services.AppStateService AppState
@inject NavigationManager Nav

<div class="auth-form-wrapper">
    <h2>Sign in</h2>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-error">@_errorMessage</div>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="_model.Email" type="email" placeholder="you@example.com" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" class="form-control" @bind-Value="_model.Password" type="password" placeholder="••••••••" />
        </div>

        <button type="submit" class="btn btn-primary btn-full" disabled="@_loading">
            @if (_loading) { <span>Signing in...</span> } else { <span>Sign in</span> }
        </button>
    </EditForm>

    <p class="auth-footer-link">
        Don't have an account? <a href="/register">Create one</a>
    </p>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _errorMessage;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (AppState.IsAuthenticated)
            Nav.NavigateTo("/dashboard");
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        var success = await AuthService.LoginAsync(_model.Email, _model.Password);
        if (success)
            Nav.NavigateTo("/dashboard");
        else
            _errorMessage = "Invalid email or password. Please try again.";

        _loading = false;
        StateHasChanged();
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
