@page "/barber"
@using System.Text.Json
@using FlatPurse.Models
@using FlatPurse.Components.Shared
@inject FlatPurse.Services.IAppStateService AppState
@inject FlatPurse.Services.IBookingService BookingService
@inject NavigationManager Nav
@implements IDisposable

<div class="barber-mode">
    <div class="barber-header">
        <div class="barber-logo">
            <div class="barber-logo-mark">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <span>FlatPurse Flow</span>
        </div>
        <div class="barber-header-right">
            <div class="barber-ap-badge">
                <div class="pulse-dot"></div>
                AutoPilot ON
            </div>
            <a href="/" class="barber-exit-btn">Exit Barber Mode</a>
        </div>
    </div>

    <div class="barber-clock-section">
        <div class="barber-date">@_now.ToString("dddd, MMMM d")</div>
        <div class="barber-time">@_now.ToString("H:mm")</div>
        <div class="barber-time-ampm">@_now.ToString("tt")</div>
    </div>

    <div class="barber-body">
        <div class="barber-next">
            @if (_loading)
            {
                <LoadingSpinner />
            }
            else if (_nextUp != null)
            {
                var initials = GetInitials(_nextUp.ClientName);
                var color = GetColor(_nextUp.ClientName);
                <div class="barber-next-label">Next up</div>
                <div class="barber-next-card">
                    <div class="barber-next-time">@_nextUp.StartsAt.ToString("H:mm")</div>
                    <div class="barber-next-avatar" style="background:@color">@initials</div>
                    <div class="barber-next-info">
                        <div class="barber-next-name">@_nextUp.ClientName</div>
                        <div class="barber-next-service">@_nextUp.ServiceName</div>
                    </div>
                    <div class="barber-next-price">$@_nextUp.Price</div>
                </div>
            }
            else
            {
                <div class="barber-next-label">No more appointments today</div>
            }
        </div>

        <div class="barber-schedule">
            <div class="barber-schedule-title">Today's Lineup</div>
            <div class="barber-schedule-list">
                @foreach (var appt in _bookings)
                {
                    var initials = GetInitials(appt.ClientName);
                    var color = GetColor(appt.ClientName);
                    var statusClass = appt.Status switch
                    {
                        BookingStatus.Completed => "done",
                        BookingStatus.InProgress => "next",
                        BookingStatus.Confirmed => "upcoming",
                        BookingStatus.Pending => "upcoming",
                        _ => ""
                    };
                    var statusLabel = appt.Status switch
                    {
                        BookingStatus.Completed => "Done",
                        BookingStatus.InProgress => "Next",
                        BookingStatus.Confirmed => "Upcoming",
                        BookingStatus.Pending => "Pending",
                        BookingStatus.Cancelled => "Cancelled",
                        BookingStatus.NoShow => "No-Show",
                        _ => appt.Status.ToString()
                    };
                    <div class="barber-appt @(statusClass == "done" ? "barber-appt-done" : statusClass == "next" ? "barber-appt-next" : "")">
                        <span class="barber-appt-time">@appt.StartsAt.ToString("H:mm")</span>
                        <div class="barber-appt-avatar" style="background:@color">@initials</div>
                        <div class="barber-appt-info">
                            <div class="barber-appt-name">@appt.ClientName</div>
                            <div class="barber-appt-service">@appt.ServiceName</div>
                        </div>
                        <span class="barber-appt-price">$@appt.Price</span>
                        <span class="barber-appt-status status-@statusClass">@statusLabel</span>
                    </div>
                }
                @if (!_bookings.Any() && !_loading)
                {
                    <div style="padding:20px;text-align:center;color:var(--text-3)">No appointments today</div>
                }
            </div>
        </div>

        <div class="barber-actions">
            <a href="/payments/checkout" class="barber-action-btn barber-checkout">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                Checkout
            </a>
            <a href="/bookings/new" class="barber-action-btn barber-new">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New Booking
            </a>
        </div>
    </div>
</div>

@code {
    private DateTime _now = DateTime.Now;
    private System.Timers.Timer? _timer;
    private bool _loading = true;
    private List<BookingDto> _bookings = new();
    private BookingDto? _nextUp;

    private static readonly string[] _avatarColors = { "#534AB7", "#DB2777", "#16A34A", "#9333EA", "#0284C7", "#D97706", "#DC2626", "#0891B2" };

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][..1]}{parts[^1][..1]}".ToUpper();
        return parts.Length == 1 ? parts[0][..1].ToUpper() : "?";
    }

    private static string GetColor(string name) =>
        _avatarColors[Math.Abs(name.GetHashCode()) % _avatarColors.Length];

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated) { Nav.NavigateTo("/login"); return; }

        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, _) =>
        {
            _now = DateTime.Now;
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();

        await LoadTodayBookingsAsync().ConfigureAwait(false);
    }

    private async Task LoadTodayBookingsAsync()
    {
        _loading = true;
        var today = DateTime.Today;
        var result = await BookingService.GetBookingsAsync(from: today, to: today.AddDays(1), limit: 100).ConfigureAwait(false);

        if (result != null)
        {
            var json = JsonSerializer.Serialize(result);
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("items", out var items))
            {
                _bookings = JsonSerializer.Deserialize<List<BookingDto>>(items.GetRawText(),
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }

        _bookings = _bookings.OrderBy(b => b.StartsAt).ToList();
        _nextUp = _bookings.FirstOrDefault(b =>
            b.Status == BookingStatus.InProgress ||
            (b.Status is BookingStatus.Confirmed or BookingStatus.Pending && b.StartsAt >= DateTime.Now));
        _loading = false;
    }

    public void Dispose() => _timer?.Dispose();
}
