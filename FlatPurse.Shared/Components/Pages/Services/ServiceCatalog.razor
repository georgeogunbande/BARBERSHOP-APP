@page "/services"
@layout MainLayout
@using FlatPurse.Models
@using FlatPurse.Components.Shared
@inject FlatPurse.Services.IServiceCatalogService SvcCatalog
@inject FlatPurse.Services.IAppStateService AppState
@inject NavigationManager Nav

<div class="page-header">
    <div>
        <h1 class="page-title">Services</h1>
        <p class="page-subtitle">@(_services?.Count ?? 0) services configured</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal">+ Add Service</button>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_services.Count == 0)
{
    <EmptyState Message="No services yet. Add your first service to get started." />
}
else
{
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Category</th>
                    <th>Duration</th>
                    <th>Price</th>
                    <th>Deposit</th>
                    <th>Bookings</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var svc in _services)
                {
                    <tr>
                        <td style="font-weight:700">@svc.Name</td>
                        <td style="color:var(--text-3)">@(svc.Category ?? "General")</td>
                        <td>@svc.DurationMins min</td>
                        <td style="font-family:var(--mono);font-weight:700">$@svc.Price.ToString("F2")</td>
                        <td>@(svc.DepositPct > 0 ? $"{svc.DepositPct}%" : "None")</td>
                        <td>@svc.BookingCount</td>
                        <td>
                            <span class="badge @(svc.Active ? "badge-green" : "badge-red")">
                                @(svc.Active ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-ghost" style="font-size:11px;padding:4px 10px" @onclick="() => OpenEditModal(svc)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(_editingService == null ? "Add Service" : "Edit Service")</h2>
                <button class="modal-close" @onclick="CloseModal">&#x2715;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-error" style="margin-bottom:16px">@_error</div>
                }
                <div class="form-group">
                    <label class="form-label">Service Name *</label>
                    <input class="form-control" type="text" @bind="_name" placeholder="e.g. Classic Haircut" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Price ($) *</label>
                        <input class="form-control" type="number" step="0.01" min="0" @bind="_price" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Duration (min) *</label>
                        <input class="form-control" type="number" min="5" step="5" @bind="_duration" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <input class="form-control" type="text" @bind="_category" placeholder="e.g. Haircuts, Grooming" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Deposit %</label>
                        <input class="form-control" type="number" min="0" max="100" @bind="_depositPct" />
                    </div>
                </div>
                @if (_editingService != null)
                {
                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-control" @bind-Value="_active">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </InputSelect>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_submitting">
                    @(_submitting ? "Saving..." : (_editingService == null ? "Add Service" : "Save Changes"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ServiceDto> _services = new();
    private bool _loading = true;
    private bool _showModal;
    private bool _submitting;
    private string? _error;

    // Form fields
    private ServiceDto? _editingService;
    private string _name = string.Empty;
    private decimal _price;
    private int _duration = 30;
    private string? _category;
    private decimal _depositPct;
    private string _active = "true";

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        await LoadServicesAsync();
    }

    private async Task LoadServicesAsync()
    {
        _loading = true;
        StateHasChanged();
        var result = await SvcCatalog.GetAllAsync();
        _services = result?.ToList() ?? new();
        _loading = false;
        StateHasChanged();
    }

    private void OpenAddModal()
    {
        _editingService = null;
        _name = string.Empty;
        _price = 0;
        _duration = 30;
        _category = null;
        _depositPct = 0;
        _active = "true";
        _error = null;
        _showModal = true;
    }

    private void OpenEditModal(ServiceDto svc)
    {
        _editingService = svc;
        _name = svc.Name;
        _price = svc.Price;
        _duration = svc.DurationMins;
        _category = svc.Category;
        _depositPct = svc.DepositPct;
        _active = svc.Active.ToString().ToLower();
        _error = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingService = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Service name is required.";
            return;
        }
        if (_price <= 0)
        {
            _error = "Price must be greater than 0.";
            return;
        }
        if (_duration < 5)
        {
            _error = "Duration must be at least 5 minutes.";
            return;
        }

        _submitting = true;
        StateHasChanged();

        try
        {
            if (_editingService == null)
            {
                var req = new CreateServiceRequest(
                    _name.Trim(), _price, _duration,
                    string.IsNullOrWhiteSpace(_category) ? null : _category.Trim(),
                    _depositPct);
                var created = await SvcCatalog.CreateAsync(req);
                if (created == null) { _error = "Failed to create service."; return; }
            }
            else
            {
                var req = new UpdateServiceRequest(
                    _name.Trim(), _price, _duration,
                    string.IsNullOrWhiteSpace(_category) ? null : _category.Trim(),
                    _active == "true", _depositPct);
                var updated = await SvcCatalog.UpdateAsync(_editingService.Id, req);
                if (updated == null) { _error = "Failed to update service."; return; }
            }

            CloseModal();
            await LoadServicesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }
}
