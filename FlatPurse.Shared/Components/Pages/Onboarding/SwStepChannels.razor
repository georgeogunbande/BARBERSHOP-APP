<div class="sw-card">
    <h2 class="sw-card-title">Communication channels</h2>
    <p class="sw-card-sub">Where should clients hear from you?</p>

    <div class="sw-channel-list">
        @foreach (var ch in _channels)
        {
            <div class="sw-channel-row">
                <div class="sw-channel-icon">@ch.Icon</div>
                <div class="sw-channel-info">
                    <div class="sw-channel-name">@ch.Name</div>
                    <div class="sw-channel-hint">@ch.Hint</div>
                </div>
                <label class="sw-toggle">
                    <input type="checkbox" @bind="ch.Enabled" />
                    <span class="sw-toggle-track"></span>
                </label>
            </div>
        }
    </div>

    <div class="sw-nav-row">
        <button class="sw-btn-ghost" @onclick="OnBack">← Back</button>
        <button class="sw-btn-primary sw-btn-sm" @onclick="OnNext">Continue →</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    class Channel { public string Name = ""; public string Hint = ""; public string Icon = ""; public bool Enabled; }
    List<Channel> _channels =
    [
        new() { Name = "SMS",           Hint = "via Twilio",         Icon = "💬", Enabled = true  },
        new() { Name = "Email",         Hint = "",                   Icon = "✉️", Enabled = true  },
        new() { Name = "Instagram DM",  Hint = "",                   Icon = "📸", Enabled = false },
        new() { Name = "Push notifications", Hint = "",              Icon = "🔔", Enabled = true  },
    ];
}
