<div class="sw-card">
    <h2 class="sw-card-title">Your business</h2>
    <p class="sw-card-sub">Business name and location.</p>

    <div class="sw-form-group">
        <label class="sw-label">BUSINESS NAME</label>
        <input class="sw-input" placeholder="Slinde Cuts" @bind="_name" />
    </div>

    <div class="sw-form-group">
        <label class="sw-label">CITY</label>
        <input class="sw-input" placeholder="Edmonton, AB" @bind="_city" />
    </div>

    <div class="sw-form-group">
        <label class="sw-label">BUSINESS TYPE</label>
        <div class="sw-chip-group">
            @foreach (var t in _types)
            {
                <button class="sw-chip @(_type == t ? "sw-chip--active" : "")" @onclick="() => _type = t">@t</button>
            }
        </div>
    </div>

    <div class="sw-nav-row">
        <button class="sw-btn-ghost" @onclick="OnBack">← Back</button>
        <button class="sw-btn-primary sw-btn-sm" @onclick="OnNext">Continue →</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    string _name = "";
    string _city = "";
    string _type = "Barbershop";
    static readonly string[] _types = ["Barbershop", "Hair salon", "Beauty studio"];
}
