@page "/welcome"
@layout FlatPurse.Components.Layout.AuthLayout
@inject NavigationManager Nav

<div class="onboarding-page">
    <div class="onboarding-card">
        <div class="onboarding-logo">
            <div class="onboarding-logo-mark">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <div class="onboarding-logo-text">
                <span class="onboarding-brand">FlatPurse</span>
                <span class="onboarding-tag">FLOW</span>
            </div>
        </div>

        <h1 class="onboarding-title">Welcome to<br/>FlatPurse Flow</h1>
        <p class="onboarding-sub">The AI-powered barbershop platform that runs your business on autopilot.</p>

        <div class="onboarding-features">
            <div class="onboarding-feature">
                <div class="onboarding-feature-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </div>
                <div>
                    <div class="onboarding-feature-title">Smart Booking</div>
                    <div class="onboarding-feature-desc">Online booking with deposit protection and no-show prevention</div>
                </div>
            </div>
            <div class="onboarding-feature">
                <div class="onboarding-feature-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
                    </svg>
                </div>
                <div>
                    <div class="onboarding-feature-title">AutoPilot AI</div>
                    <div class="onboarding-feature-desc">Win-back lapsed clients, fill cancellations, and recover revenue automatically</div>
                </div>
            </div>
            <div class="onboarding-feature">
                <div class="onboarding-feature-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                    </svg>
                </div>
                <div>
                    <div class="onboarding-feature-title">Fast Checkout</div>
                    <div class="onboarding-feature-desc">Tap-to-pay, payment links, and instant payouts for your chair</div>
                </div>
            </div>
            <div class="onboarding-feature">
                <div class="onboarding-feature-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div>
                    <div class="onboarding-feature-title">Client Intelligence</div>
                    <div class="onboarding-feature-desc">AI-driven insights, churn prediction, and lifetime value tracking</div>
                </div>
            </div>
        </div>

        <div class="onboarding-stats">
            <div class="onboarding-stat">
                <div class="onboarding-stat-value">$340</div>
                <div class="onboarding-stat-label">Avg. monthly AutoPilot recovery</div>
            </div>
            <div class="onboarding-stat-divider"></div>
            <div class="onboarding-stat">
                <div class="onboarding-stat-value">84%</div>
                <div class="onboarding-stat-label">Rebook rate improvement</div>
            </div>
            <div class="onboarding-stat-divider"></div>
            <div class="onboarding-stat">
                <div class="onboarding-stat-value">2 min</div>
                <div class="onboarding-stat-label">Average checkout time</div>
            </div>
        </div>

        <div class="onboarding-actions">
            <a href="/register" class="btn-onboarding-primary">Get started free</a>
            <a href="/login" class="btn-onboarding-secondary">Sign in</a>
        </div>

        <div class="onboarding-trust">
            <span>🔒 SOC 2 Type II</span>
            <span>·</span>
            <span>PCI DSS</span>
            <span>·</span>
            <span>PIPEDA Compliant</span>
        </div>
    </div>
</div>
