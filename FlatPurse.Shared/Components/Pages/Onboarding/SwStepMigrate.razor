<div class="sw-card">
    <h2 class="sw-card-title">Import your clients</h2>
    <p class="sw-card-sub">Switch from your current platform in one tap.</p>

    <div class="sw-platform-list">
        @foreach (var p in _platforms)
        {
            <div class="sw-platform-row">
                <div class="sw-platform-avatar" style="background: @p.Color">@p.Initial</div>
                <div class="sw-platform-info">
                    <div class="sw-platform-name">@p.Name</div>
                    <div class="sw-platform-hint">Tap to import</div>
                </div>
                <button class="sw-btn-import" @onclick="() => p.Imported = true">
                    @(p.Imported ? "✓ Done" : "Import")
                </button>
            </div>
        }
    </div>

    <button class="sw-link-btn" @onclick="OnNext">or upload a CSV file →</button>

    <div class="sw-nav-row">
        <button class="sw-btn-ghost" @onclick="OnBack">← Back</button>
        <button class="sw-btn-primary sw-btn-sm" @onclick="OnNext">Continue →</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    record PlatformItem(string Name, string Initial, string Color) { public bool Imported { get; set; } }

    List<PlatformItem> _platforms =
    [
        new("Fresha",       "F", "#00C896"),
        new("Vagaro",       "V", "#7C3AED"),
        new("Booksy",       "B", "#2563EB"),
        new("GlossGenius",  "G", "#F59E0B"),
        new("Square",       "S", "#1A1A1A"),
    ];
}
