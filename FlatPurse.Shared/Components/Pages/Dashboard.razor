@page "/"
@page "/dashboard"
@layout MainLayout
@using FlatPurse.Models
@inject FlatPurse.Services.IAppStateService AppState
@inject FlatPurse.Services.IDashboardService DashboardService
@inject FlatPurse.Services.IAutoPilotService AutoPilotService
@inject FlatPurse.Services.IStaffService StaffService
@inject NavigationManager Nav

@if (!AppState.IsAuthenticated)
{
    <span></span>
    return;
}

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <!-- Mobile greeting (visible <= 768px) -->
    <div class="mobile-greeting">
        <div class="greeting-left">
            <h1 class="greeting-title">Good morning, @(AppState.CurrentUser?.FirstName ?? "there") <span class="greeting-wave">👋</span></h1>
            <p class="greeting-sub">@DateTime.Today.ToString("dddd") · @(_brief?.UpcomingBookings?.Count ?? 0) bookings before noon</p>
        </div>
        @if (AppState.CurrentUser != null)
        {
            var fn = AppState.CurrentUser.FirstName ?? "";
            var ln = AppState.CurrentUser.LastName ?? "";
            var initials = $"{(fn.Length > 0 ? fn[..1] : "")}{(ln.Length > 0 ? ln[..1] : "")}".ToUpper();
            <div class="greeting-avatar" style="background:var(--green)">@(initials.Length > 0 ? initials : "U")</div>
        }
    </div>

    <!-- Mobile AutoPilot recovered banner -->
    @if ((_apStats?.TotalRevenueRecovered ?? 0) > 0)
    {
        <div class="mobile-ap-banner">
            <div class="mobile-ap-banner-label">AUTOPILOT RECOVERED TODAY</div>
            <div class="mobile-ap-banner-value">C$@(_apStats!.TotalRevenueRecovered.ToString("N0"))</div>
            <div class="mobile-ap-banner-sub">@(_apStats.WinbacksTriggered) win-backs sent · @(_apStats.SlotsFilled) slot filled · @(_apStats.NoShowsRecovered) upsells</div>
        </div>
    }

    <!-- Stat cards row -->
    <div class="stat-row">
        <div class="stat-card accent-green">
            <div class="stat-label">Revenue Today</div>
            <div class="stat-value">C$@(_brief?.RevenueTodayProjected.ToString("N0") ?? "0")</div>
        </div>
        <div class="stat-card accent-purple">
            <div class="stat-label">Bookings</div>
            <div class="stat-value">@(_brief?.AppointmentsToday ?? 0)</div>
            <div class="stat-delta positive">+@(_brief?.UpcomingBookings?.Count ?? 0) vs forecast</div>
        </div>
        <div class="stat-card accent-amber">
            <div class="stat-label">No-Show Risk</div>
            <div class="stat-value">@(_brief?.Alerts?.Count ?? 0)</div>
            @if ((_brief?.Alerts?.Count ?? 0) > 0)
            {
                <div class="stat-delta warning"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg> Deposits req'd</div>
            }
        </div>
        <div class="stat-card accent-blue">
            <div class="stat-label">Win-Back Wins</div>
            <div class="stat-value">@(_apStats?.WinbacksTriggered ?? 0)</div>
            @if ((_apStats?.TotalRevenueRecovered ?? 0) > 0)
            {
                <div class="stat-delta positive">+C$@(_apStats!.TotalRevenueRecovered.ToString("N0")) recovered</div>
            }
        </div>
    </div>

    <!-- Main two-column grid -->
    <div class="main-grid">
        <!-- Left column: Schedule + AI -->
        <div>
            <div class="card">
                <div class="card-header">
                    <span class="card-title">Today's Schedule</span>
                    <span class="card-badge badge-purple">@(_brief?.UpcomingBookings?.Count ?? 0) UPCOMING</span>
                </div>
                <div class="schedule-list">
                    @if (_brief?.UpcomingBookings != null && _brief.UpcomingBookings.Any())
                    {
                        @foreach (var appt in _brief.UpcomingBookings)
                        {
                            var parts = (appt.ClientName ?? "?").Split(' ', 2);
                            var initials = $"{(parts[0].Length > 0 ? parts[0][..1] : "?")}{(parts.Length > 1 && parts[1].Length > 0 ? parts[1][..1] : "")}".ToUpper();
                            var color = _avatarColors[Math.Abs(appt.ClientName.GetHashCode()) % _avatarColors.Length];
                            var statusLabel = appt.Status switch
                            {
                                BookingStatus.Completed => "Done",
                                BookingStatus.InProgress => "Up next",
                                BookingStatus.Confirmed => "Confirmed",
                                BookingStatus.Cancelled => "Cancelled",
                                BookingStatus.NoShow => "No-show",
                                _ => "Pending"
                            };
                            var statusClass = appt.Status switch
                            {
                                BookingStatus.Completed => "done",
                                BookingStatus.InProgress => "next",
                                BookingStatus.Cancelled or BookingStatus.NoShow => "risk",
                                _ => "confirmed"
                            };
                            <div class="schedule-item">
                                <span class="appt-time">@appt.StartsAt.ToString("H:mm")</span>
                                <div class="appt-avatar" style="background:@color">@initials</div>
                                <div class="appt-info">
                                    <div class="appt-name">@appt.ClientName</div>
                                    <div class="appt-service">@appt.ServiceName</div>
                                </div>
                                <span class="appt-status status-@statusClass">@statusLabel</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state" style="padding:32px 20px">
                            <div class="empty-state-icon">📅</div>
                            <div>No appointments today</div>
                        </div>
                    }
                </div>
            </div>

            @if (_brief?.AutoPilotHighlights?.Any() == true || _brief?.Alerts?.Any() == true)
            {
                <div class="card" style="margin-top:14px">
                    <div class="card-header">
                        <span class="card-title">AI Recommendations</span>
                        <span class="card-badge badge-green">LIVE</span>
                    </div>
                    <div class="ai-list">
                        @if (_brief.AutoPilotHighlights != null)
                        {
                            @foreach (var highlight in _brief.AutoPilotHighlights)
                            {
                                <div class="ai-card">
                                    <div class="ai-type slot">WIN-BACK</div>
                                    <div class="ai-card-body">@highlight</div>
                                    <button class="ai-btn">Send all</button>
                                </div>
                            }
                        }
                        @if (_brief.Alerts != null)
                        {
                            @foreach (var alert in _brief.Alerts)
                            {
                                <div class="ai-card">
                                    <div class="ai-type winback">ALERT</div>
                                    <div class="ai-card-body">@alert</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right column: Quick stats + Team + AutoPilot -->
        <div class="right-col">
            <div class="quick-stats">
                <div class="qs-cell">
                    <div class="qs-label">Messages Sent</div>
                    <div class="qs-value">@(_apStats?.MessagesSent ?? 0)</div>
                    <div class="qs-sub">Today via AutoPilot</div>
                </div>
                <div class="qs-cell">
                    <div class="qs-label">Winbacks</div>
                    <div class="qs-value">@(_apStats?.WinbacksTriggered ?? 0)</div>
                    <div class="qs-sub">Triggered today</div>
                </div>
                <div class="qs-cell">
                    <div class="qs-label">Reviews</div>
                    <div class="qs-value">@(_apStats?.ReviewsRequested ?? 0)</div>
                    <div class="qs-sub">Requested today</div>
                </div>
                <div class="qs-cell">
                    <div class="qs-label">Slots Filled</div>
                    <div class="qs-value">@(_apStats?.SlotsFilled ?? 0)</div>
                    <div class="qs-sub">By AutoPilot</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <span class="card-title">Team Today</span>
                    <span class="card-badge badge-green">@(_staff?.Count(s => s.IsActive) ?? 0) ACTIVE</span>
                </div>
                @if (_staff != null && _staff.Any(s => s.IsActive))
                {
                    @foreach (var m in _staff.Where(s => s.IsActive))
                    {
                        var mfn = m.FirstName ?? "";
                        var mln = m.LastName ?? "";
                        var initials = $"{(mfn.Length > 0 ? mfn[..1] : "")}{(mln.Length > 0 ? mln[..1] : "")}".ToUpper();
                        var color = m.Colour ?? _avatarColors[Math.Abs(m.FirstName.GetHashCode()) % _avatarColors.Length];
                        <div class="team-item">
                            <div class="team-avatar" style="background:@color">@initials</div>
                            <div>
                                <div class="team-name">@m.FirstName @m.LastName</div>
                                <div class="team-role">@m.Role</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state" style="padding:20px">No team members yet</div>
                }
            </div>

            <div class="card">
                <div class="card-header">
                    <span class="card-title">AutoPilot Today</span>
                    <span class="card-badge badge-green">ACTIVE</span>
                </div>
                <div style="padding:16px 20px;display:flex;flex-direction:column;gap:10px">
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text-3)">Slots filled</span>
                        <span style="font-weight:700;color:var(--green)">@(_apStats?.SlotsFilled ?? 0)</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text-3)">Messages sent</span>
                        <span style="font-weight:700;color:var(--text)">@(_apStats?.MessagesSent ?? 0)</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text-3)">Revenue recovered</span>
                        <span style="font-weight:700;color:var(--purple)">$@(_apStats?.TotalRevenueRecovered.ToString("N0") ?? "0")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text-3)">Review requests</span>
                        <span style="font-weight:700;color:var(--text)">@(_apStats?.ReviewsRequested ?? 0)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private DailyBriefDto? _brief;
    private AutoPilotStatsDto? _apStats;
    private IEnumerable<StaffDto>? _staff;

    private static readonly string[] _avatarColors = { "#534AB7", "#DB2777", "#0891B2", "#D97706", "#9333EA", "#DC2626", "#0284C7", "#16A34A" };

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var briefTask = DashboardService.GetTodayBriefAsync();
        var statsTask = AutoPilotService.GetStatsAsync();
        var staffTask = StaffService.GetAllAsync();

        await Task.WhenAll(briefTask, statsTask, staffTask).ConfigureAwait(false);

        _brief = briefTask.Result;
        _apStats = statsTask.Result;
        _staff = staffTask.Result;
        _loading = false;
    }
}
