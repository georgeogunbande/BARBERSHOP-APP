@page "/settings"
@using FlatPurse.Models
@using FlatPurse.Components.Shared
@inject FlatPurse.Services.ISettingsService SettingsService
@inject FlatPurse.Services.IAppStateService AppState
@inject NavigationManager Nav

<div class="page-header">
    <h1 class="page-title">Settings</h1>
</div>

<div class="tab-bar">
    <button class="tab-btn @(_activeTab == "Business" ? "active" : "")" @onclick='() => _activeTab = "Business"'>Business</button>
    <button class="tab-btn @(_activeTab == "Plan" ? "active" : "")" @onclick='() => _activeTab = "Plan"'>Plan</button>
    <button class="tab-btn @(_activeTab == "Notifications" ? "active" : "")" @onclick='() => _activeTab = "Notifications"'>Notifications</button>
    <button class="tab-btn @(_activeTab == "Channels" ? "active" : "")" @onclick='() => _activeTab = "Channels"'>Channels</button>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <div class="tab-content">
        @if (_activeTab == "Business")
        {
            <div class="settings-section">
                <h3>Business Information</h3>
                @if (_settings?.Business != null)
                {
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Business Name</span>
                            <span>@_settings.Business.Name</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">City</span>
                            <span>@(_settings.Business.City ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Type</span>
                            <span>@(_settings.Business.Type ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Booking Handle</span>
                            <span>@(_settings.Business.BookingHandle ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Currency</span>
                            <span>@(_settings.Business.Currency ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Theme</span>
                            <span>@(_settings.Business.ActiveTheme ?? "Default")</span>
                        </div>
                    </div>
                }
                else if (AppState.CurrentUser?.Business != null)
                {
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Business Name</span>
                            <span>@AppState.CurrentUser.Business.Name</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">City</span>
                            <span>@(AppState.CurrentUser.Business.City ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Type</span>
                            <span>@(AppState.CurrentUser.Business.Type ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Plan</span>
                            <span>@AppState.CurrentUser.Business.Plan</span>
                        </div>
                    </div>
                }
            </div>

            <div class="settings-section">
                <h3>Booking Settings</h3>
                @if (_settings?.Booking != null)
                {
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Min Advance Notice</span>
                            <span>@_settings.Booking.MinAdvanceNoticeHours hours</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Max Advance Days</span>
                            <span>@_settings.Booking.MaxAdvanceDays days</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Public Booking</span>
                            <span>@(_settings.Booking.AllowPublicBooking ? "Enabled" : "Disabled")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Require Deposit</span>
                            <span>@(_settings.Booking.RequireDeposit ? "Yes" : "No")</span>
                        </div>
                    </div>
                }
            </div>

            <div class="settings-section">
                <h3>Your Profile</h3>
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Name</span>
                        <span>@AppState.CurrentUser?.FirstName @AppState.CurrentUser?.LastName</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Email</span>
                        <span>@AppState.CurrentUser?.Email</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Role</span>
                        <span>@AppState.CurrentUser?.Role</span>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == "Plan")
        {
            <div class="settings-section">
                <h3>Subscription</h3>
                @if (_subscription != null)
                {
                    <div class="plan-card">
                        <div class="plan-name">@_subscription.Plan</div>
                        @if (_subscription.IsTrialing && _subscription.TrialEndsAt.HasValue)
                        {
                            <div class="trial-badge">Trial ends @_subscription.TrialEndsAt.Value.ToString("MMM d, yyyy")</div>
                        }
                        <div class="plan-status @(_subscription.IsActive ? "active" : "inactive")">
                            @(_subscription.IsActive ? "Active" : "Inactive")
                        </div>
                        @if (_subscription.CurrentPeriodEnd.HasValue)
                        {
                            <p>Renews @_subscription.CurrentPeriodEnd.Value.ToString("MMM d, yyyy")</p>
                        }
                    </div>
                    <div class="plan-options">
                        @foreach (var plan in Enum.GetValues<SubscriptionPlan>())
                        {
                            <div class="plan-option @(_subscription.Plan == plan ? "current" : "")">
                                <h4>@plan</h4>
                                @if (_subscription.Plan == plan)
                                {
                                    <span class="badge">Current</span>
                                }
                                else
                                {
                                    <button class="btn btn-outline">Upgrade</button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (_activeTab == "Notifications")
        {
            <div class="settings-section">
                <h3>Notification Preferences</h3>
                <p class="settings-desc">Configure which notifications you receive.</p>
                @if (_notifications != null)
                {
                    <div class="toggle-list">
                        <div class="toggle-item">
                            <span>Booking Confirmations</span>
                            <input type="checkbox" checked="@_notifications.BookingConfirmations" />
                        </div>
                        <div class="toggle-item">
                            <span>Booking Reminders</span>
                            <input type="checkbox" checked="@_notifications.BookingReminders" />
                        </div>
                        <div class="toggle-item">
                            <span>Payment Receipts</span>
                            <input type="checkbox" checked="@_notifications.PaymentReceipts" />
                        </div>
                        <div class="toggle-item">
                            <span>AutoPilot Alerts</span>
                            <input type="checkbox" checked="@_notifications.AutoPilotAlerts" />
                        </div>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "Channels")
        {
            <div class="settings-section">
                <h3>Connected Channels</h3>
                <p class="settings-desc">Connect communication channels for messaging and autopilot.</p>
                @if (_channels != null && _channels.Any())
                {
                    <div class="channels-list">
                        @foreach (var ch in _channels)
                        {
                            <div class="channel-card">
                                <span class="channel-type">@ch.Type</span>
                                <span class="channel-status status-@ch.Status.ToString().ToLower()">@ch.Status</span>
                                @if (ch.ExternalAccountName != null)
                                {
                                    <span class="channel-account">@ch.ExternalAccountName</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <EmptyState Message="No channels connected yet." />
                }
            </div>
        }
    </div>
}

@code {
    private bool _loading = true;
    private string _activeTab = "Business";
    private BusinessSettingsDto? _settings;
    private SubscriptionDto? _subscription;
    private NotificationSettingsDto? _notifications;
    private IEnumerable<ChannelDto>? _channels;

    protected override async Task OnInitializedAsync()
    {
        if (!AppState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var settingsTask = SettingsService.GetSettingsAsync();
        var subTask = SettingsService.GetSubscriptionAsync();
        var channelsTask = SettingsService.GetChannelsAsync();

        await Task.WhenAll(settingsTask, subTask, channelsTask).ConfigureAwait(false);

        _settings = settingsTask.Result;
        _notifications = _settings?.Notifications;
        _subscription = subTask.Result;
        _channels = channelsTask.Result;

        _loading = false;
    }
}
