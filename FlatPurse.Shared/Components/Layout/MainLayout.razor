@inherits LayoutComponentBase
@inject FlatPurse.Services.IAppStateService AppState
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (!AppState.IsAuthenticated)
{
    <div class="auth-page">
        @Body
    </div>
}
else
{
    <div class="app-shell" id="app-shell">
        <NavSidebar />
        <div class="main">
            <div class="topbar">
                <div class="topbar-left">
                    <h1>@_pageTitle</h1>
                    <div class="sub">@DateTime.Now.ToString("dddd, MMMM d · h:mm tt")</div>
                </div>
                <div class="topbar-right">
                    <div class="autopilot-badge">
                        <div class="pulse-dot"></div>
                        AutoPilot ON
                    </div>
                    <button class="topbar-btn" title="Notifications">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        <div class="dot"></div>
                    </button>
                    <button class="topbar-btn" title="Toggle theme" @onclick="ToggleThemeAsync">
                        @if (_isDark)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                        }
                    </button>
                    <a href="/bookings/new" class="new-booking-btn">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>New Booking</span>
                    </a>
                </div>
            </div>
            <div class="content">
                @Body
            </div>
            <div class="trust-bar">
                <div class="trust-item">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    SOC 2 Type II
                </div>
                <div class="trust-dot"></div>
                <div class="trust-item">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    PCI DSS
                </div>
                <div class="trust-dot"></div>
                <div class="trust-item">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    PIPEDA Compliant
                </div>
                <div class="trust-dot"></div>
                <div class="trust-item">256-bit Encryption</div>
            </div>
        </div>
    </div>

    <!-- Mobile bottom navigation -->
    <MobileNavBottom/>
}

@code {
    private bool _isDark = false;
    private string _pageTitle = "Dashboard";

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdateTitle(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
            // Default to dark if no preference saved
            if (saved == "light")
            {
                _isDark = false;
            }
            else
            {
                _isDark = true;
                await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", "dark");
            }
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        var theme = _isDark ? "dark" : "light";
        await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", theme);
        await JS.InvokeVoidAsync("localStorage.setItem", "theme", theme);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateTitle(e.Location);
        StateHasChanged();
    }

    private void UpdateTitle(string url)
    {
        _pageTitle = url switch
        {
            var u when u.Contains("/bookings") => "Bookings",
            var u when u.Contains("/clients") => "Clients",
            var u when u.Contains("/payments") => "Payments",
            var u when u.Contains("/messaging") => "Messaging",
            var u when u.Contains("/autopilot") => "AutoPilot",
            var u when u.Contains("/operations") => "Operations",
            var u when u.Contains("/reports") => "Reports",
            var u when u.Contains("/staff") => "Team",
            var u when u.Contains("/team") => "Team",
            var u when u.Contains("/services") => "Services",
            var u when u.Contains("/settings") => "Settings",
            var u when u.Contains("/barber") => "Barber Mode",
            _ => "Dashboard"
        };
    }

    private void OnStateChanged() => StateHasChanged();

    public void Dispose()
    {
        AppState.OnChange -= OnStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
