{
  "ConnectionStrings": {
    "AuthDb": "Server=your-server.database.windows.net;Database=BarbershopAuth;Authentication=Active Directory Default;Encrypt=True",
    "AppDb": "Server=your-server.database.windows.net;Database=BarbershopApp;Authentication=Active Directory Default;Encrypt=True"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_256_BIT_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "BarbershopApi",
    "Audience": "BarbershopApp",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
